# ---------------------------------------------------------------------------
# CloudPlay configuration. Copy to .env.local (dev) or set in your host.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# SQLite database file (created automatically). Default: ./data/cloudplay.db
DATABASE_PATH=./data/cloudplay.db

# Optional bearer token for non-browser API clients (CSRF bypass for scripts).
# Leave empty to only allow same-origin browser requests.
API_TOKEN=

# Set to "true" only when running behind a trusted reverse proxy that sets
# X-Forwarded-For / X-Forwarded-Host (used for rate limiting and origin checks).
TRUST_PROXY=false

# Allow plain-http direct media URLs (default: https only).
ALLOW_HTTP_MEDIA=false

# Transfer engine limits
MAX_TRANSFER_BYTES=4294967296
MAX_CONCURRENT_TRANSFERS=2
# Private temp directory for transfers (default: OS temp dir)
TRANSFER_TMP_DIR=

# ---------------------------------------------------------------------------
# TeraBox Open Platform (NOT YET INTEGRATED, see TECHNICAL_FEASIBILITY.md)
# Obtain these by applying for an app on the official TeraBox Open Platform:
#   https://www.terabox.com/integrations/docs
# Setting them only changes the status reported in Settings. No TeraBox API
# calls are made until an adapter is implemented against verified docs.
# ---------------------------------------------------------------------------
TERABOX_CLIENT_ID=
TERABOX_CLIENT_SECRET=

# Diskwala: no official API exists, so there are no credentials to configure.
